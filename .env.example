# Browser / Vite
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
# Legacy fallback (optional)
# VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"

# Netlify / server-side only — NEVER expose these as VITE_ variables
# SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
# PUBLIC_SITE_ORIGIN="https://your-domain.example"

# Supabase Edge Function secrets — configure with `supabase secrets set`
# VAPID_SUBJECT="mailto:admin@your-domain.example"
# VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"
# VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY"

# Cloudflare Pages Function
SITE_URL=https://your-domain.example
